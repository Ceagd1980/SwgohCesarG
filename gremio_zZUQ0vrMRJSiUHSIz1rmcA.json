<script src="./gremio_zZUQ0vrMRJSiUHSIz1rmcA_files/equipos.js.descarga"></script>
<script>
/* ======================= ESTADO ======================= */
const S = {
  chars:{}, ships:{}, names:{}, dbErr:'',
  acc: CUENTAS.map(c=>({cfg:c, st:'load', p:null, units:new Map(), err:''})),
  sel: 0, sec: 'resumen',
  squadSize: 5, counterLead: 'SITHPALPATINE',
  roster:{fac:'*', side:'*', minR:-1, q:'', sort:'power', showLocked:false, group:true},
  plan:{mode:'gac', ndef:5, casi:false},
  rival:{code:'', st:'', err:'', p:null, units:new Map()}
};
const SECS = [['resumen','Resumen'],['roster','Roster por facción'],['equipos','Equipos'],['counters','Counters GAC'],['rival','🔍 Revisar rival'],['tw','⚔ Gremios / TW'],['plan','Plan GAC / TW'],['rote','ROTE'],['naves','Naves'],['diag','Diagnóstico']];
const META_TAGS = new Set(['Leader','Fleet Commander','Order 66 Raid','Attacker','Support','Tank','Healer']);

/* ======================= DATOS ======================= */
async function api(path){
  try{
    const r = await fetch('/.netlify/functions/swgoh?path='+encodeURIComponent(path));
    if(r.ok) return await r.json();
    let msg='Función respondió '+r.status; try{const j=await r.json(); if(j.error) msg=j.error}catch(e){}
    throw new Error(msg);
  }catch(e){
    try{ const r2 = await fetch(`https://swgoh.gg/api/${path}/`); if(r2.ok) return await r2.json(); }catch(_){}
    throw e;
  }
}
function lsGet(k){try{const v=localStorage.getItem(k);return v?JSON.parse(v):null}catch(e){return null}}
function lsSet(k,v){try{localStorage.setItem(k,JSON.stringify(v))}catch(e){}}

function toDB(arr){
  const out={};
  (arr||[]).forEach(u=>{
    const id=u.b||u.base_id; if(!id) return;
    out[id]={name:u.n||u.name, image:u.i||u.image, cat:u.c||u.categories||[], al:u.a||u.alignment||'', role:u.r||u.role||'', slug:u.s||((u.url||'').match(/units\/([^/]+)/)||[])[1]||''};
  });
  return out;
}
async function loadDB(force){
  const cache = lsGet('swgoh_db3');
  if(cache && !force && Date.now()-cache.t < 3*864e5 && Object.keys(cache.chars).length>100){ S.chars=cache.chars; S.ships=cache.ships; return; }
  // 1) archivos subidos al repo (characters.json / ships.json descargados de swgoh.gg)
  const local = async f => { try{ const r=await fetch(f,{cache:'no-cache'}); if(r.ok) return parseLoose(await r.text()); }catch(e){} return null; };
  let c = await local('characters.json'), s = await local('ships.json');
  S.dbSrc = c ? 'archivo characters.json del repo' : '';
  // 2) si no están, se piden a swgoh.gg
  try{
    if(!c){ c = await api('characters'); S.dbSrc='swgoh.gg en vivo'; }
    if(!s){ s = await api('ships').catch(()=>[]); }
  }catch(e){ S.dbErr=String(e.message||e); }
  const chars = toDB(c||[]);
  if(Object.keys(chars).length>100){
    S.chars=chars; S.ships=toDB(s||[]); S.dbErr='';
    lsSet('swgoh_db3',{t:Date.now(),chars:S.chars,ships:S.ships});
  } else {
    if(!S.dbErr) S.dbErr='lista de personajes incompleta';
    const manual = lsGet('swgoh_db_manual');
    if(manual){ S.chars=manual.chars; S.ships=manual.ships||{}; S.dbSrc='archivo cargado a mano'; S.dbErr=''; }
    else if(cache){ S.chars=cache.chars; S.ships=cache.ships; }
  }
}
// acepta el JSON tal cual o una página guardada que lo contiene
function parseLoose(txt){
  try{ return JSON.parse(txt); }catch(e){}
  const a=txt.indexOf('['), b=txt.lastIndexOf(']');
  if(a<0||b<a) throw new Error('no encontré la lista');
  const raw=txt.slice(a,b+1).replace(/&quot;/g,'"').replace(/&amp;/g,'&').replace(/&lt;/g,'<').replace(/&gt;/g,'>');
  return JSON.parse(raw);
}
function loadManualFile(file, kind){
  const rd=new FileReader();
  rd.onload=()=>{
    try{
      const db=toDB(parseLoose(rd.result)); if(Object.keys(db).length<10) throw new Error('lista vacía');
      const prev=lsGet('swgoh_db_manual')||{chars:{},ships:{}};
      if(kind==='ships') prev.ships=db; else prev.chars=db;
      lsSet('swgoh_db_manual',prev);
      if(kind==='ships') S.ships=db; else { S.chars=db; S.dbErr=''; S.dbSrc='archivo cargado a mano'; }
      render();
    }catch(e){ alert('Ese archivo no es la lista de swgoh.gg: '+e.message); }
  };
  rd.readAsText(file);
}
function normPlayer(p){
  const units = new Map();
  (p.units||[]).forEach(x=>{
    const u = x.data||x; const gear = u.gear_level||0;
    if(u.name) S.names[u.base_id]=u.name;
    units.set(u.base_id,{
      id:u.base_id, name:u.name, gear, stars:u.rarity||0, power:u.power||0, ct:u.combat_type||1,
      relic: gear>=13 ? Math.max(0,(u.relic_tier||2)-2) : -1,
      gl: !!u.is_galactic_legend, zetas:(u.zeta_abilities||[]).length, omis:(u.omicron_abilities||[]).length
    });
  });
  return units;
}
async function fetchPlayer(code){
  const p = await api('player/'+code);
  return {data:p.data, units:(p.units||[]).map(x=>{const u=x.data||x;return {data:{base_id:u.base_id,name:u.name,gear_level:u.gear_level,power:u.power,rarity:u.rarity,relic_tier:u.relic_tier,combat_type:u.combat_type,is_galactic_legend:u.is_galactic_legend,zeta_abilities:u.zeta_abilities||[],omicron_abilities:u.omicron_abilities||[]}}})};
}
async function loadAcc(i, force){
  const a = S.acc[i], key='swgoh_p_'+a.cfg.codigo;
  const cache = lsGet(key);
  if(cache && !force){ a.p=cache.p; a.units=normPlayer(cache.p); a.st='ok'; a.t=cache.t; }
  if(cache && !force && Date.now()-cache.t < 30*60e3) return;
  a.st = a.p ? 'ok' : 'load'; renderTabs();
  try{
    const p = await fetchPlayer(a.cfg.codigo);
    a.p=p; a.units=normPlayer(p); a.st='ok'; a.err=''; a.t=Date.now();
    lsSet(key,{t:a.t,p});
  }catch(e){ if(!a.p) a.st='err'; a.err=String(e.message||e); }
}

/* ======================= UTILIDADES ======================= */
const fmt = n => (n||0).toLocaleString('es-EC');
const fmtM = n => ((n||0)/1e6).toFixed(2)+' M';
const esc = s => String(s??'').replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
const info = id => S.chars[id]||S.ships[id]||null;
const uname = id => info(id)?.name || S.names[id] || ABREV[id] || id;     // nombre completo
const lab = id => ABREV[id] || info(id)?.name || S.names[id] || id;         // abreviatura o nombre
function sideCls(id){const al=(info(id)?.al||'');return al.startsWith('Light')?'ls':al.startsWith('Dark')?'ds':'nt'}
function initials(id){return lab(id).replace(/[^A-Za-z0-9 ]/g,'').split(/\s+/).map(w=>w[0]).join('').slice(0,3)||'?'}
function portrait(id, u, o={}){
  const im = info(id)?.image;
  const cls = ['p',sideCls(id), o.sm?'sm':'', (u?.gl||o.gl)?'gl':'', (!u&&!o.free)?'off':'', (u&&o.min!=null&&u.relic<o.min)?'low':''].join(' ');
  let badge='';
  if(u){ badge = u.relic>=0 ? `<span class="badge ${u.relic>=8?'r8':''}">R${u.relic}</span>` : (u.ct===2?`<span class="badge g">${u.stars}★</span>`:`<span class="badge g">G${u.gear}</span>`); }
  const tip = esc(uname(id)) + (u?` · ${u.stars}★ · ${u.relic>=0?'R'+u.relic:'G'+u.gear} · ${fmt(u.power)} PG${u.zetas?` · ${u.zetas}Z`:''}${u.omis?` · ${u.omis}Ω`:''}`:(o.free?'':' · no lo tienes'));
  return `<div class="${cls}" title="${tip}"><div class="img">${im?`<img loading="lazy" src="${im}" alt="" onerror="this.remove()">`:''}<span class="ini">${esc(initials(id))}</span></div>${badge}${o.multi?`<div class="multi">${o.multi}</div>`:''}<div class="nm">${esc(lab(id))}</div></div>`;
}
const accs = () => S.sel==='all' ? S.acc.filter(a=>a.p) : [S.acc[S.sel]].filter(a=>a.p);
function relicCount(a,min,ct=1){let n=0;a.units.forEach(u=>{if(u.ct===ct&&u.relic>=min)n++});return n}
const glCount = a => [...a.units.values()].filter(u=>u.gl).length;

function evalSquad(sq, a, size=S.squadSize){
  const U = id => a.units.get(id);
  const core = sq.core.slice(0,size);
  const missing = core.filter(id=>!U(id) || (U(id).stars<7 && !U(id).gl));
  const need = Math.max(0, size-core.length);
  const flexOwned = sq.flex.filter(id=>U(id)).sort((x,y)=>(U(y).relic-U(x).relic)||(U(y).power-U(x).power));
  const pick = flexOwned.slice(0,need);
  const ids = [...core, ...pick];
  const low = ids.filter(id=>U(id) && U(id).relic < sq.relic);
  const complete = sq.flex.length===0 || pick.length>=need;
  const estado = missing.length ? 'falta' : (low.length===0 && complete ? 'listo' : 'casi');
  const power = ids.reduce((s,id)=>s+(U(id)?.power||0),0);
  return {estado, ids, missing, low, power, need:sq.flex.length?Math.max(0,need-pick.length):0};
}
function evalIds(ids, a, min=7){
  const U=id=>a.units.get(id);
  if(ids.some(id=>!U(id))) return 'falta';
  return ids.every(id=>U(id).relic>=min) ? 'listo' : 'casi';
}
const chipTxt = {listo:'Listo',casi:'Casi',falta:'No disponible'};

/* Counters importados por el usuario (páginas de swgoh.gg guardadas) y counters.json del repo */
S.ctrRepo = {};
function ctrImported(){ return lsGet('swgoh_ctr_import')||{}; }
function ctrSource(lead){
  const imp=ctrImported()[lead]; if(imp&&imp.rows?.length) return {rows:imp.rows,src:`importado de swgoh.gg el ${new Date(imp.t).toLocaleDateString('es-EC')}${imp.season?' · '+imp.season:''}`};
  const rep=S.ctrRepo[lead]; if(rep&&rep.rows?.length) return {rows:rep.rows,src:`counters.json del repo${rep.season?' · '+rep.season:''}`};
  return {rows:null,src:COUNTERS_FUENTE};
}
function countersFor(lead){
  const s=ctrSource(lead);
  if(s.rows) return s.rows.slice().sort((x,y)=>(y.win-x.win)||(y.seen-x.seen));
  const map=new Map();
  (COUNTERS_BASE[lead]||[]).forEach(s=>{
    const [squad,seen,win]=s.split('|'); const ids=squad.split(',').map(x=>x.trim()).filter(Boolean);
    const k=ids.join(','), row={ids,seen:+seen||0,win:+win||0};
    const prev=map.get(k); if(!prev||row.seen>prev.seen) map.set(k,row);
  });
  return [...map.values()].sort((x,y)=>(y.win-x.win)||(y.seen-x.seen));
}
/* Lee una página de counters de swgoh.gg guardada con Ctrl+S */
function parseCountersPage(html){
  const lead = (html.match(/gac\/counters\/([A-Z0-9_]+)\/?["?]/)||html.match(/d_lead=([A-Z0-9_]+)/)||[])[1];
  const sm = html.replace(/<[^>]+>/g,' ').match(/Season\s*(\d+)\s*-\s*(5v5|3v3)/i);
  const season = sm ? `Temporada ${sm[1]} · ${sm[2]}` : '';
  const parts = html.split(/[?&](?:amp;)?a_lead=/).slice(1);
  const map=new Map(); let acc=null;
  for(const part of parts){
    const ld=(part.match(/^([A-Z0-9_]+)/)||[])[1]; if(!ld) continue;
    const cut = part.split(/[?&](?:amp;)?d_member=/)[0];
    const mem=[...cut.matchAll(/[?&](?:amp;)?a_member=([A-Z0-9_]+)/g)].map(m=>m[1]);
    if(!acc || acc.lead!==ld) acc={lead:ld,mem:new Set()};
    mem.forEach(m=>acc.mem.add(m));
    const text=part.replace(/<[^>]+>/g,' ').replace(/&nbsp;/g,' ').replace(/\s+/g,' ');
    const seen=+((text.match(/Seen\s*([\d.,]+\s*K?)/i)||[])[1]||'0').replace(/,/g,'').replace(/\s*K$/i,'000').replace(/\.(\d)000$/,'$100');
    const win=+((text.match(/Win\s*%\s*([\d.]+)/i)||[])[1]||0);
    if(!seen) continue;
    const ids=[acc.lead,...[...acc.mem].filter(m=>m!==acc.lead)];
    const k=ids[0]+'|'+ids.slice(1).sort().join(',');
    const prev=map.get(k);
    if(prev){ const t=prev.seen+seen; prev.win=Math.round((prev.win*prev.seen+win*seen)/t); prev.seen=t; }
    else map.set(k,{ids,seen,win});
    acc=null;
  }
  return {lead, season, rows:[...map.values()]};
}
function importCounterFiles(files){
  const out=[]; let pending=files.length; if(!pending) return;
  [...files].forEach(f=>{
    const rd=new FileReader();
    rd.onload=()=>{
      try{
        const r=parseCountersPage(rd.result);
        if(r.lead && r.rows.length){ const all=ctrImported(); all[r.lead]={t:Date.now(),season:r.season,rows:r.rows}; lsSet('swgoh_ctr_import',all); out.push(`✔ ${lab(r.lead)}: ${r.rows.length} equipos`); S.counterLead=r.lead; }
        else out.push(`✘ ${f.name}: no encontré counters (¿guardaste la página completa?)`);
      }catch(e){ out.push(`✘ ${f.name}: ${e.message}`); }
      if(--pending===0){ S.importMsg=out.join(' · '); render(); }
    };
    rd.readAsText(f);
  });
}
function downloadCountersJSON(){
  const data={...S.ctrRepo, ...ctrImported()};
  const blob=new Blob([JSON.stringify(data)],{type:'application/json'});
  const a=document.createElement('a'); a.href=URL.createObjectURL(blob); a.download='counters.json'; a.click();
}
function ctrRow(r, list){
  const acc = list.map(a=>{const st=evalIds(r.ids,a);return `<span class="mini ${st}" title="${esc(a.cfg.nombre)}: ${chipTxt[st]}">${esc(a.cfg.nombre)}</span>`}).join('');
  const mine = S.sel==='all'?null:list[0];
  return `<div class="ctr"><div class="ports">${r.ids.map(id=>portrait(id,mine?mine.units.get(id):null,{sm:true,free:!mine,min:7})).join('')}</div>
    <div class="meta"><b class="pct">${r.win}%</b> <span class="small muted">· ${fmt(r.seen)} batallas</span><div class="small">${r.ids.map(lab).map(esc).join(' + ')}</div></div>
    <div class="acc">${acc}</div></div>`;
}
const swggUrl = id => `https://swgoh.gg/gac/counters/${id}/?season_id=${TEMPORADA_5V5}`;
const swggLink = id => `<a href="${swggUrl(id)}" target="_blank" rel="noopener">Ver counters 5v5 en swgoh.gg ↗</a>`;

/* ======================= CABECERA ======================= */
function renderTabs(){
  const el=document.getElementById('accTabs');
  el.innerHTML = S.acc.map((a,i)=>`<button class="acc-tab ${S.sel===i?'on':''}" data-i="${i}"><span class="dot ${a.st}"></span>${esc(a.cfg.nombre)}<small>${a.p?fmtM(a.p.data?.galactic_power):a.cfg.codigo}</small></button>`).join('')
   + `<button class="acc-tab ${S.sel==='all'?'on':''}" data-i="all">★ Todas</button>`;
  el.querySelectorAll('.acc-tab').forEach(b=>b.onclick=()=>{S.sel=b.dataset.i==='all'?'all':+b.dataset.i;renderTabs();render()});
  document.getElementById('secNav').innerHTML = SECS.map(([k,t])=>`<button class="${S.sec===k?'on':''}" data-k="${k}">${t}</button>`).join('');
  document.querySelectorAll('#secNav button').forEach(b=>b.onclick=()=>{S.sec=b.dataset.k;renderTabs();render()});
}

/* ======================= SECCIONES ======================= */
function render(){
  const app=document.getElementById('app');
  const list = accs();
  const warn = !Object.keys(S.chars).length ? `<div class="err-box" style="margin-bottom:12px">Faltan fotos y facciones: swgoh.gg no deja que Netlify lea su lista de personajes${S.dbErr?' ('+esc(S.dbErr)+')':''}. Se arregla una sola vez subiendo esa lista al repo: mira los pasos en <a href="#" id="goDiag" style="color:#fff;font-weight:600">Diagnóstico</a>.</div>` : '';
  if(!list.length && !['diag','rival','tw'].includes(S.sec)){
    const a = S.sel==='all'?null:S.acc[S.sel];
    app.innerHTML = warn + (a && a.st==='err'
      ? `<div class="err-box">No se pudo cargar <b>${esc(a.cfg.nombre)}</b> (${a.cfg.codigo}): ${esc(a.err)}.</div>`
      : `<div class="panel">Cargando datos de swgoh.gg…</div>`);
    return;
  }
  const f = {resumen:vResumen,roster:vRoster,equipos:vEquipos,counters:vCounters,rival:vRival,tw:vTW,plan:vPlan,rote:vRote,naves:vNaves,diag:vDiag}[S.sec];
  app.innerHTML = warn + f(list);
  bind();
}

function statsGrid(d,a){
  return `<div class="grid-stats">
    <div class="stat"><div class="v">${fmtM(d.galactic_power)}</div><div class="l">Poder galáctico</div></div>
    <div class="stat"><div class="v">${fmtM(d.character_galactic_power)}</div><div class="l">PG personajes</div></div>
    <div class="stat"><div class="v">${fmtM(d.ship_galactic_power)}</div><div class="l">PG naves</div></div>
    <div class="stat"><div class="v">${d.skill_rating??'–'}</div><div class="l">GAC · ${esc(d.league_name||'')} Div ${d.division_number??''}</div></div>
    <div class="stat"><div class="v">${d.arena_rank??'–'}</div><div class="l">Rango arena</div></div>
    <div class="stat"><div class="v">${d.fleet_arena?.rank??'–'}</div><div class="l">Rango flota</div></div>
    <div class="stat"><div class="v">${glCount(a)}</div><div class="l">Leyendas Galácticas</div></div>
    <div class="stat"><div class="v">${relicCount(a,7)} · ${relicCount(a,8)} · ${relicCount(a,9)}</div><div class="l">R7+ · R8+ · R9</div></div>
  </div>`;
}
function arenaBlock(d,a){
  const ar=d.arena||{}, fl=d.fleet_arena||{};
  return `<h3>Equipo de arena</h3><div class="ports">${[ar.leader,...(ar.members||[])].filter(Boolean).map(id=>portrait(id,a.units.get(id))).join('')||'<span class="muted small">—</span>'}</div>
    <h3 style="margin-top:12px">Flota de arena</h3><div class="ports">${[fl.leader,...(fl.members||[])].filter(Boolean).map(id=>portrait(id,a.units.get(id))).join('')||'<span class="muted small">—</span>'}</div>
    ${fl.reinforcements?.length?`<div class="small muted" style="margin-top:6px">Refuerzos:</div><div class="ports">${fl.reinforcements.map(id=>portrait(id,a.units.get(id),{sm:true})).join('')}</div>`:''}`;
}

function vResumen(list){
  if(S.sel==='all'){
    const tot = k => list.reduce((s,a)=>s+(a.p.data?.[k]||0),0);
    const glIds=new Set(); list.forEach(a=>a.units.forEach(u=>{if(u.gl)glIds.add(u.id)}));
    return `<div class="panel"><h2>Las ${list.length} cuentas</h2><div class="grid-stats">
      <div class="stat"><div class="v">${fmtM(tot('galactic_power'))}</div><div class="l">PG total</div></div>
      <div class="stat"><div class="v">${fmtM(tot('character_galactic_power'))}</div><div class="l">PG personajes</div></div>
      <div class="stat"><div class="v">${fmtM(tot('ship_galactic_power'))}</div><div class="l">PG naves</div></div>
      <div class="stat"><div class="v">${list.reduce((s,a)=>s+glCount(a),0)}</div><div class="l">Leyendas Galácticas</div></div></div></div>
    <div class="panel"><h2>Comparativa</h2><div class="tbl-wrap"><table><thead><tr><th>Cuenta</th><th class="n">PG</th><th class="n">Pers.</th><th class="n">Naves</th><th class="n">GL</th><th class="n">R5+</th><th class="n">R7+</th><th class="n">R8+</th><th class="n">R9</th><th class="n">Arena</th><th class="n">Flota</th><th class="n">GAC</th><th>Gremio</th></tr></thead><tbody>
    ${list.map(a=>{const d=a.p.data||{};return `<tr><td><b>${esc(d.name||a.cfg.nombre)}</b><div class="small muted">${a.cfg.codigo}</div></td><td class="n">${fmtM(d.galactic_power)}</td><td class="n">${fmtM(d.character_galactic_power)}</td><td class="n">${fmtM(d.ship_galactic_power)}</td><td class="n">${glCount(a)}</td><td class="n">${relicCount(a,5)}</td><td class="n">${relicCount(a,7)}</td><td class="n">${relicCount(a,8)}</td><td class="n">${relicCount(a,9)}</td><td class="n">${d.arena_rank??'–'}</td><td class="n">${d.fleet_arena?.rank??'–'}</td><td class="n">${d.skill_rating??'–'}</td><td>${esc(d.guild_name||'')}</td></tr>`}).join('')}
    </tbody></table></div></div>
    <div class="panel"><h2>Leyendas Galácticas por cuenta</h2><div class="tbl-wrap"><table><thead><tr><th>GL</th>${list.map(a=>`<th>${esc(a.cfg.nombre)}</th>`).join('')}</tr></thead><tbody>
    ${[...glIds].sort((x,y)=>lab(x).localeCompare(lab(y))).map(id=>`<tr><td><div class="row">${portrait(id,null,{sm:true,free:true,gl:true})}<span title="${esc(uname(id))}">${esc(lab(id))}</span></div></td>${list.map(a=>{const u=a.units.get(id);return `<td>${u?`<b style="color:var(--gold)">R${u.relic}</b>`:'<span class="muted">—</span>'}</td>`}).join('')}</tr>`).join('') || `<tr><td class="muted">Ninguna todavía</td></tr>`}
    </tbody></table></div></div>`;
  }
  const a=list[0], d=a.p.data||{};
  const chars=[...a.units.values()].filter(u=>u.ct===1);
  const dist=[]; for(let r=9;r>=0;r--) dist.push([r,chars.filter(u=>u.relic===r).length]);
  const maxD=Math.max(1,...dist.map(x=>x[1]));
  const top=chars.slice().sort((x,y)=>y.power-x.power).slice(0,16);
  const gls=chars.filter(u=>u.gl);
  return `<div class="panel"><h2>${esc(d.name||a.cfg.nombre)} <span class="muted small">· ${a.cfg.codigo} · ${esc(d.title||'')}</span></h2>${statsGrid(d,a)}
    <p class="small muted">Gremio: <b>${esc(d.guild_name||'—')}</b> · Última sincronización en swgoh.gg: ${d.last_updated?new Date(d.last_updated).toLocaleString('es-EC'):'—'}</p></div>
  <div class="cols"><div class="panel">${arenaBlock(d,a)}</div>
    <div class="panel"><h3>Reliquias</h3>${dist.map(([r,n])=>`<div class="row" style="margin:3px 0"><span style="width:34px" class="rj">R${r}</span><div class="bar" style="flex:1"><i style="width:${n/maxD*100}%"></i></div><span style="width:30px;text-align:right">${n}</span></div>`).join('')}</div></div>
  ${gls.length?`<div class="panel"><h3>Leyendas Galácticas</h3><div class="ports">${gls.map(u=>portrait(u.id,u)).join('')}</div></div>`:''}
  <div class="panel"><h3>Personajes más fuertes</h3><div class="ports">${top.map(u=>portrait(u.id,u)).join('')}</div></div>`;
}

function vRoster(list){
  const R=S.roster;
  const hasDB = Object.keys(S.chars).length>0;
  const allFac=new Set(); Object.values(S.chars).forEach(c=>c.cat.forEach(t=>{if(!META_TAGS.has(t))allFac.add(t)}));
  const facs=[...allFac].sort();
  const pool = hasDB ? Object.keys(S.chars) : [...new Set(list.flatMap(a=>[...a.units.values()].filter(u=>u.ct===1).map(u=>u.id)))];
  const ids = pool.filter(id=>{
    const c=S.chars[id]||{cat:[],al:''};
    if(R.side!=='*' && !c.al.startsWith(R.side)) return false;
    if(R.fac!=='*' && !c.cat.includes(R.fac)) return false;
    if(R.q){const q=R.q.toLowerCase(); if(!uname(id).toLowerCase().includes(q) && !lab(id).toLowerCase().includes(q)) return false;}
    const owned = list.some(a=>a.units.has(id));
    if(!owned && !R.showLocked) return false;
    if(R.minR>=0 && !list.some(a=>(a.units.get(id)?.relic??-1)>=R.minR)) return false;
    return true;
  });
  const best = id => list.reduce((b,a)=>{const u=a.units.get(id);return u&&(!b||u.relic>b.relic||(u.relic===b.relic&&u.power>b.power))?u:b},null);
  const sorter = {power:(x,y)=>(best(y)?.power||0)-(best(x)?.power||0), relic:(x,y)=>((best(y)?.relic??-9)-(best(x)?.relic??-9))||((best(y)?.power||0)-(best(x)?.power||0)), name:(x,y)=>lab(x).localeCompare(lab(y))}[R.sort];
  const card = id => S.sel==='all'
    ? portrait(id,best(id),{multi:list.map(a=>{const u=a.units.get(id);return u?(u.relic>=0?'R'+u.relic:'G'+u.gear):'–'}).join('·')})
    : portrait(id,list[0].units.get(id));
  let body;
  if(R.group && R.fac==='*' && hasDB){
    const groups = facs.map(f=>[f, ids.filter(id=>S.chars[id].cat.includes(f)).sort(sorter)]).filter(g=>g[1].length);
    body = groups.map(([f,g])=>`<details class="fac" ${groups.length<=6?'open':''}><summary><span>${esc(f)}</span><span class="muted small">${g.length} · R7+: ${g.filter(id=>(best(id)?.relic??-1)>=7).length}</span></summary><div class="ports">${g.map(card).join('')}</div></details>`).join('');
  } else body = `<div class="ports">${ids.sort(sorter).map(card).join('')}</div>`;
  return `<div class="panel"><h2>Roster por facción ${S.sel==='all'?'<span class="small muted">· debajo de cada retrato: nivel en cada cuenta ('+list.map(a=>esc(a.cfg.nombre)).join(' · ')+')</span>':''}</h2>
  <div class="ctrl">
    <select id="rFac"><option value="*">Todas las facciones</option>${facs.map(f=>`<option ${R.fac===f?'selected':''}>${esc(f)}</option>`).join('')}</select>
    <select id="rSide"><option value="*">Ambos lados</option><option value="Light" ${R.side==='Light'?'selected':''}>Lado Luminoso</option><option value="Dark" ${R.side==='Dark'?'selected':''}>Lado Oscuro</option><option value="Neutral" ${R.side==='Neutral'?'selected':''}>Neutral</option></select>
    <select id="rMin"><option value="-1">Cualquier nivel</option>${[1,3,5,6,7,8,9].map(r=>`<option value="${r}" ${R.minR===r?'selected':''}>R${r} o más</option>`).join('')}</select>
    <select id="rSort"><option value="power" ${R.sort==='power'?'selected':''}>Ordenar: poder</option><option value="relic" ${R.sort==='relic'?'selected':''}>Ordenar: reliquia</option><option value="name" ${R.sort==='name'?'selected':''}>Ordenar: nombre</option></select>
    <input type="text" id="rQ" placeholder="Buscar personaje…" value="${esc(R.q)}">
    <label class="chk"><input type="checkbox" id="rGroup" ${R.group?'checked':''}> Agrupar por facción</label>
    <label class="chk"><input type="checkbox" id="rLocked" ${R.showLocked?'checked':''}> Mostrar los que no tengo</label>
  </div>
  <p class="small muted">${ids.length} personajes · Borde azul = Luminoso, rojo = Oscuro, dorado = Leyenda Galáctica.</p>
  ${body||'<p class="muted">Nada con esos filtros.</p>'}</div>`;
}

function squadCard(sq, list, opts={}){
  const ev = list.map(a=>({a,e:evalSquad(sq,a)}));
  const head = `<div class="sq-h"><div class="row">${portrait(sq.lider,null,{free:true,sm:true})}<div><h3>${esc(sq.nombre)}</h3><div class="small muted">${esc(sq.faccion)} · R${sq.relic}+ ${sq.def?'· 🛡 buena defensa':''}</div></div></div><span class="tier ${sq.tier===1?'t1':''}">T${sq.tier}</span></div>`;
  const lead = `<div class="small muted" style="margin-bottom:6px">Núcleo: <b>${sq.core.map(lab).map(esc).join(', ')}</b>${sq.flex.length?` · Opciones: ${sq.flex.map(lab).map(esc).join(', ')}`:''}${sq.nota?` · <i>${esc(sq.nota)}</i>`:''}</div>`;
  const body = ev.map(({a,e})=>{
    const ids = e.ids.length? e.ids : sq.core;
    return `<div class="accrow"><span class="an">${esc(a.cfg.nombre)}<br><span class="chip ${e.estado}">${chipTxt[e.estado]}</span></span>${e.estado==='falta'?`<span class="small muted">Falta: ${e.missing.map(lab).map(esc).join(', ')}</span>`:`<div class="ports">${ids.map(id=>portrait(id,a.units.get(id),{sm:true,min:sq.relic})).join('')}${e.need?`<span class="small muted">+${e.need} libre(s)</span>`:''}</div>`}</div>`;
  }).join('');
  return {ev, html:`<div class="sq">${head}${lead}${body}</div>`};
}
function vEquipos(list){
  const cards = EQUIPOS.slice().sort((x,y)=>x.tier-y.tier).map(sq=>{
    const c=squadCard(sq,list);
    if(S.onlyReady && !c.ev.some(x=>x.e.estado==='listo')) return '';
    return c.html;
  }).join('');
  return `<div class="panel"><h2>Equipos meta según tu roster</h2>
  <div class="ctrl"><select id="sqSize"><option value="5" ${S.squadSize===5?'selected':''}>5v5</option><option value="3" ${S.squadSize===3?'selected':''}>3v3</option></select>
