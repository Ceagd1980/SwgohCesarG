<style>
:root{
  --bg:#0b1424; --bg2:#0f1c33; --panel:#13233f; --panel2:#182b4d; --line:#24395f;
  --tx:#e6edf7; --tx2:#9fb0cc; --tx3:#6e809f;
  --gold:#f5b523; --blue:#2f8cff; --ls:#3ea0ff; --ds:#ff4d5a; --ok:#2ecc71; --warn:#f5a623; --bad:#e2485a;
  --r:10px;
}
*{box-sizing:border-box}
html,body{margin:0;background:var(--bg);color:var(--tx);font:14px/1.45 Inter,system-ui,sans-serif}
a{color:var(--blue)}
h1,h2,h3,.rj{font-family:Rajdhani,Inter,sans-serif;letter-spacing:.3px}
header{background:linear-gradient(180deg,#0d3a6e,#0a2a52);border-bottom:1px solid #134a86;position:sticky;top:0;z-index:20}
.top{display:flex;align-items:center;gap:14px;padding:10px 16px;max-width:1400px;margin:0 auto;flex-wrap:wrap}
.logo{font:700 24px Rajdhani;color:#fff;display:flex;align-items:center;gap:8px;white-space:nowrap}
.logo b{color:var(--gold)}
.acc-tabs{display:flex;gap:6px;flex-wrap:wrap;flex:1}
.acc-tab{background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.12);color:#dfe8f6;padding:6px 12px;border-radius:8px;cursor:pointer;font:600 14px Rajdhani;display:flex;gap:6px;align-items:center}
.acc-tab small{color:var(--tx2);font:500 11px Inter}
.acc-tab.on{background:var(--gold);color:#1b1300;border-color:var(--gold)}
.acc-tab.on small{color:#4a3600}
.dot{width:8px;height:8px;border-radius:50%;background:var(--tx3)}
.dot.ok{background:var(--ok)}.dot.err{background:var(--bad)}.dot.load{background:var(--warn);animation:pul 1s infinite}
@keyframes pul{50%{opacity:.3}}
.btn{background:var(--blue);color:#fff;border:0;border-radius:8px;padding:7px 12px;font:600 13px Inter;cursor:pointer}
.btn.ghost{background:transparent;border:1px solid var(--line);color:var(--tx)}
nav.sec{display:flex;gap:4px;padding:0 16px;max-width:1400px;margin:0 auto;overflow-x:auto}
nav.sec button{background:none;border:0;color:#c9d6ea;padding:10px 12px;font:600 15px Rajdhani;cursor:pointer;border-bottom:3px solid transparent;white-space:nowrap}
nav.sec button.on{color:#fff;border-color:var(--gold)}
main{max-width:1400px;margin:0 auto;padding:16px}
.panel{background:var(--panel);border:1px solid var(--line);border-radius:var(--r);padding:14px;margin-bottom:14px}
.panel h2{margin:0 0 10px;font-size:20px}
.panel h3{margin:0 0 8px;font-size:17px}
.muted{color:var(--tx2)} .small{font-size:12px}
.grid-stats{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:10px}
.stat{background:var(--panel2);border:1px solid var(--line);border-radius:8px;padding:10px}
.stat .v{font:700 22px Rajdhani;color:#fff}.stat .l{color:var(--tx2);font-size:12px}
.row{display:flex;gap:10px;flex-wrap:wrap;align-items:center}
.ctrl{display:flex;gap:10px;flex-wrap:wrap;align-items:center;margin-bottom:12px}
select,input[type=text],input[type=number]{background:var(--bg2);color:var(--tx);border:1px solid var(--line);border-radius:8px;padding:7px 9px;font:13px Inter}
label.chk{display:flex;gap:6px;align-items:center;color:var(--tx2);font-size:13px}
/* retratos */
.ports{display:flex;flex-wrap:wrap;gap:8px}
.p{position:relative;width:62px;text-align:center}
.p .img{width:62px;height:62px;border-radius:50%;border:3px solid var(--tx3);overflow:hidden;background:#0a1222;display:flex;align-items:center;justify-content:center;font:700 13px Rajdhani;color:var(--tx2)}
.p .img img{width:100%;height:100%;object-fit:cover;display:block}
.p.ls .img{border-color:var(--ls)} .p.ds .img{border-color:var(--ds)} .p.nt .img{border-color:#9b8cff}
.p.gl .img{box-shadow:0 0 0 2px var(--gold),0 0 10px rgba(245,181,35,.6)}
.p.off{opacity:.28;filter:grayscale(1)}
.p.low .img{outline:2px dashed var(--warn);outline-offset:1px}
.p .badge{position:absolute;top:44px;left:50%;transform:translateX(-50%);background:#2b1d4f;border:1px solid #6b4fd8;color:#fff;font:700 11px Rajdhani;padding:0 5px;border-radius:6px;white-space:nowrap}
.p .badge.r8{background:#5a3b00;border-color:var(--gold);color:var(--gold)}
.p .badge.g{background:#1e2c45;border-color:#3d5683;color:#b7c6e0}
.p .nm{font-size:10px;color:var(--tx2);margin-top:8px;line-height:1.15;max-height:2.3em;overflow:hidden}
.p .st{font-size:9px;color:var(--gold);letter-spacing:-1px}
.p .multi{font:600 9px Inter;color:var(--tx2);margin-top:1px}
.p.sm{width:46px}.p.sm .img{width:46px;height:46px;border-width:2px}.p.sm .badge{top:32px;font-size:10px}.p.sm .nm{display:none}
details.fac{background:var(--panel2);border:1px solid var(--line);border-radius:8px;margin-bottom:8px}
details.fac summary{cursor:pointer;padding:9px 12px;font:600 16px Rajdhani;list-style:none;display:flex;justify-content:space-between}
details.fac summary::-webkit-details-marker{display:none}
details.fac .ports{padding:4px 12px 12px}
/* equipos */
.squads{display:grid;grid-template-columns:repeat(auto-fill,minmax(360px,1fr));gap:12px}
.sq{background:var(--panel2);border:1px solid var(--line);border-radius:10px;padding:12px}
.sq-h{display:flex;justify-content:space-between;align-items:flex-start;gap:8px;margin-bottom:8px}
.sq-h h3{margin:0;font-size:18px}
.tier{font:700 12px Rajdhani;padding:1px 7px;border-radius:5px;background:#24395f;color:#cfe0ff}
.tier.t1{background:var(--gold);color:#221700}
.chip{display:inline-block;font:600 11px Inter;padding:2px 8px;border-radius:20px}
.chip.listo{background:rgba(46,204,113,.15);color:var(--ok);border:1px solid rgba(46,204,113,.4)}
.chip.casi{background:rgba(245,166,35,.15);color:var(--warn);border:1px solid rgba(245,166,35,.4)}
.chip.falta{background:rgba(226,72,90,.12);color:#ff8090;border:1px solid rgba(226,72,90,.35)}
.accrow{display:flex;align-items:center;gap:8px;padding:6px 0;border-top:1px solid var(--line)}
.accrow .an{width:120px;font:600 13px Rajdhani;flex-shrink:0}
table{width:100%;border-collapse:collapse;font-size:13px}
th,td{padding:7px 8px;border-bottom:1px solid var(--line);text-align:left;vertical-align:middle}
th{color:var(--tx2);font-weight:600;font-size:12px;text-transform:uppercase;letter-spacing:.4px}
td.n,th.n{text-align:right;font-variant-numeric:tabular-nums}
.tbl-wrap{overflow-x:auto}
.bar{height:8px;background:#0a1222;border-radius:4px;overflow:hidden}.bar i{display:block;height:100%;background:var(--gold)}
.ls-t{color:var(--ls)}.ds-t{color:var(--ds)}.mx-t{color:#c3a6ff}
.note{background:#102a4a;border:1px solid #1d4b80;border-radius:8px;padding:10px 12px;color:#cfe0f5;font-size:13px}
.err-box{background:#3a1420;border:1px solid #7a2a3b;color:#ffc6cf;border-radius:8px;padding:10px 12px}
.cols{display:grid;grid-template-columns:repeat(auto-fit,minmax(320px,1fr));gap:12px}
.ctr{display:flex;align-items:center;gap:10px;padding:8px 0;border-top:1px solid var(--line);flex-wrap:wrap}
.ctr .meta{min-width:110px}
.ctr .acc{display:flex;gap:4px;flex-wrap:wrap}
.mini{font:600 11px Rajdhani;padding:2px 6px;border-radius:5px;background:#1b2b47;color:var(--tx3)}
.mini.listo{background:rgba(46,204,113,.18);color:var(--ok)}.mini.casi{background:rgba(245,166,35,.18);color:var(--warn)}
.p .img{position:relative}
.p .img .ini{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;z-index:0}
.p .img img{position:relative;z-index:1}
.rchip{display:inline-flex;align-items:center;background:var(--panel2);border:1px solid var(--line);border-radius:20px;overflow:hidden}
.rchip button{background:none;border:0;color:var(--tx);padding:5px 10px;cursor:pointer;font:600 13px Rajdhani}
.rchip button small{color:var(--tx3);font:400 11px Inter}
.rchip .rv-del{color:var(--tx3);padding:5px 9px;border-left:1px solid var(--line)}
.rchip .rv-del:hover{color:var(--bad)}
.pct{font:700 18px Rajdhani;color:#fff}
tr.rv-row td{background:rgba(226,72,90,.08)}
.twmap{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));grid-template-rows:repeat(6,auto);gap:10px}
.twlab{display:flex;justify-content:space-between;font:600 13px Rajdhani;color:var(--tx3);margin-bottom:4px}
.twz{background:var(--panel2);border:1px solid var(--line);border-radius:10px;padding:10px;cursor:pointer;min-width:0}
.twz:hover{border-color:#3d5683}.twz.sel{border-color:var(--gold);box-shadow:0 0 0 1px var(--gold)}
.twz.fleet{background:#122844}
.twz-h{display:flex;align-items:center;gap:8px;margin-bottom:4px}.twz-h b{font:700 20px Rajdhani}.twz-h .chip{margin-left:auto}
.twc{display:flex;flex-direction:column;align-items:center;font:600 11px Rajdhani;color:var(--tx2);max-width:64px;text-align:center}
.twsq{display:flex;align-items:center;gap:6px;background:var(--bg2);border:1px solid var(--line);border-radius:8px;padding:4px 8px}
@media (max-width:760px){.twmap{grid-template-columns:repeat(2,minmax(0,1fr));grid-template-rows:none}.twz{grid-column:auto !important;grid-row:auto !important}}
footer{color:var(--tx3);font-size:12px;text-align:center;padding:20px}
@media (max-width:640px){.squads{grid-template-columns:1fr}.accrow .an{width:84px}main{padding:10px}}
</style>
