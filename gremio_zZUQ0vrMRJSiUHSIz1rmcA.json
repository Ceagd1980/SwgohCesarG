   ${list.length?`<div class="tbl-wrap" style="margin-top:10px"><table><thead><tr><th>Comparativa</th><th class="n">PG</th><th class="n">Pers.</th><th class="n">Naves</th><th class="n">GL</th><th class="n">R7+</th><th class="n">R8+</th><th class="n">R9</th></tr></thead><tbody>
   <tr class="rv-row"><td><b>Rival · ${esc(d.name||'')}</b></td><td class="n">${fmtM(d.galactic_power)}</td><td class="n">${fmtM(d.character_galactic_power)}</td><td class="n">${fmtM(d.ship_galactic_power)}</td><td class="n">${glCount(ra)}</td><td class="n">${relicCount(ra,7)}</td><td class="n">${relicCount(ra,8)}</td><td class="n">${relicCount(ra,9)}</td></tr>
   ${list.map(a=>{const x=a.p.data||{};return `<tr><td>${esc(a.cfg.nombre)}</td><td class="n">${fmtM(x.galactic_power)}</td><td class="n">${fmtM(x.character_galactic_power)}</td><td class="n">${fmtM(x.ship_galactic_power)}</td><td class="n">${glCount(a)}</td><td class="n">${relicCount(a,7)}</td><td class="n">${relicCount(a,8)}</td><td class="n">${relicCount(a,9)}</td></tr>`}).join('')}
   </tbody></table></div>`:''}</div>`;
  // arena + GL
  const gls=[...R.units.values()].filter(u=>u.gl);
  out += `<div class="cols"><div class="panel">${arenaBlock(d,ra)}
     ${d.arena?.leader?`<h3 style="margin-top:12px">Cómo atacar su arena (${esc(lab(d.arena.leader))})</h3>${countersFor(d.arena.leader).slice(0,5).map(r=>ctrRow(r,list)).join('')||`<p class="small muted">Sin datos guardados. ${swggLink(d.arena.leader)}</p>`}`:''}</div>
    <div class="panel"><h3>Sus Leyendas Galácticas (${gls.length})</h3><div class="ports">${gls.map(u=>portrait(u.id,u)).join('')||'<span class="muted small">Ninguna</span>'}</div>
     <h3 style="margin-top:12px">Sus personajes más fuertes</h3><div class="ports">${[...R.units.values()].filter(u=>u.ct===1).sort((x,y)=>y.power-x.power).slice(0,12).map(u=>portrait(u.id,u,{sm:true})).join('')}</div></div></div>`;
  // equipos del rival + cómo atacarlos
  const theirs = EQUIPOS.map(sq=>({sq,e:evalSquad(sq,ra)})).filter(x=>x.e.estado!=='falta').sort((x,y)=>(x.e.estado==='listo'?0:1)-(y.e.estado==='listo'?0:1)||x.sq.tier-y.sq.tier||y.e.power-x.e.power);
  out += `<div class="panel"><h2>Sus equipos y cómo atacarlos</h2><p class="small muted">Equipos que el rival puede armar (posibles defensas). Debajo de cada uno: los mejores counters y si tus cuentas los tienen listos.</p></div>
