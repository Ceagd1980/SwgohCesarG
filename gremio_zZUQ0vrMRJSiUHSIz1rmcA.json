/* ======================= RIVAL ======================= */
function rivals(){return lsGet('swgoh_rivales')||[]}
async function loadRival(code){
  code=String(code||'').replace(/\D/g,'');
  if(code.length!==9){S.rival={...S.rival,st:'err',err:'El código de aliado tiene 9 números.'};render();return}
  S.rival={code,st:'load',err:'',p:null,units:new Map()}; render();
  try{
    const p=await fetchPlayer(code);
    S.rival={code,st:'ok',err:'',p,units:normPlayer(p),t:Date.now()};
    const list=rivals().filter(r=>r.codigo!==code); list.unshift({codigo:code,nombre:p.data?.name||code,t:Date.now()});
    lsSet('swgoh_rivales',list.slice(0,12));
  }catch(e){ S.rival={code,st:'err',err:String(e.message||e),p:null,units:new Map()}; }
  if(S.sec==='rival') render();
}
function vRival(list){
  const R=S.rival, rec=rivals();
  let out = `<div class="panel"><h2>🔍 Revisar rival por código de aliado</h2>
    <div class="ctrl"><input type="text" id="rvCode" placeholder="Código de aliado (ej. 123-456-789)" value="${esc(R.code)}" style="width:240px" inputmode="numeric">
