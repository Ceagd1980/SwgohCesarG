    <span class="muted">Guardar para atacar:</span><select id="twRes"><option value="none" ${O.reserve==='none'?'selected':''}>nada</option><option value="gl" ${O.reserve==='gl'?'selected':''}>las GL</option><option value="atk" ${O.reserve==='atk'?'selected':''}>los tier S de ataque</option></select>
    <label class="chk"><input type="checkbox" id="twFill" ${O.fill?'checked':''}> Si falta, rellenar con otros equipos</label></div>
