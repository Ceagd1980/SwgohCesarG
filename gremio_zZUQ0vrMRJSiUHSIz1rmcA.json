       <div class="ports">${e.ids.map(id=>portrait(id,R.units.get(id),{sm:true,min:sq.relic})).join('')}</div>
       <div class="rj" style="color:var(--blue);margin-top:10px">⚔ Atácalo con</div>
       ${ctr.length?ctr.map(r=>ctrRow(r,list)).join(''):`<p class="small muted">Sin counters guardados. ${swggLink(sq.lider)}</p>`}</div>`}).join('')||'<p class="muted">No encontré equipos meta en este roster.</p>'}</div>`;
  return out;
}

/* ======================= PLAN ======================= */
function planFor(a){
  const P=S.plan, ok = st => st==='listo' || (P.casi && st==='casi');
  const cand = EQUIPOS.map(sq=>({sq,e:evalSquad(sq,a)})).filter(x=>ok(x.e.estado));
  const used=new Set(), def=[], off=[];
  const free = x => x.e.ids.every(id=>!used.has(id));
  const take = (x,arr)=>{x.e.ids.forEach(id=>used.add(id));arr.push(x)};
  cand.slice().sort((x,y)=>(y.sq.def-x.sq.def)||(x.sq.tier-y.sq.tier)||(y.e.power-x.e.power)).forEach(x=>{ if(def.length<P.ndef && x.sq.def && free(x)) take(x,def) });
  cand.slice().sort((x,y)=>(x.sq.tier-y.sq.tier)||(y.e.power-x.e.power)).forEach(x=>{ if(def.length<P.ndef && free(x)) take(x,def) });
  cand.slice().sort((x,y)=>(x.sq.tier-y.sq.tier)||(y.e.power-x.e.power)).forEach(x=>{ if(free(x)) take(x,off) });
  return {def,off};
}
function vPlan(list){
  const P=S.plan;
  const block = (x,a)=>`<div class="accrow"><span class="an">${esc(x.sq.nombre)}<br><span class="small muted">${fmtM(x.e.power)}</span></span><div class="ports">${x.e.ids.map(id=>portrait(id,a.units.get(id),{sm:true,min:x.sq.relic})).join('')}</div></div>`;
  return `<div class="panel"><h2>Plan ${P.mode==='gac'?'GAC':'Guerra Territorial (TW)'}</h2>
  <div class="ctrl"><select id="pMode"><option value="gac" ${P.mode==='gac'?'selected':''}>GAC</option><option value="tw" ${P.mode==='tw'?'selected':''}>TW</option></select>
  <span class="muted">Equipos en defensa:</span><input type="number" id="pDef" min="1" max="30" value="${P.ndef}" style="width:70px">
  <label class="chk"><input type="checkbox" id="pCasi" ${P.casi?'checked':''}> Incluir equipos "Casi"</label>
  <select id="sqSize2"><option value="5" ${S.squadSize===5?'selected':''}>5v5</option><option value="3" ${S.squadSize===3?'selected':''}>3v3</option></select></div>
  <p class="small muted">Reparto automático sin repetir personajes: primero los mejores equipos de defensa, el resto queda para atacar.</p></div>
  <div class="cols">${list.map(a=>{const pl=planFor(a);return `<div class="panel"><h3>${esc(a.cfg.nombre)}</h3>
    <div class="rj" style="color:var(--gold)">🛡 Defensa (${pl.def.length}/${P.ndef})</div>${pl.def.map(x=>block(x,a)).join('')||'<p class="small muted">Sin equipos listos.</p>'}
    <div class="rj" style="color:var(--blue);margin-top:10px">⚔ Ataque</div>${pl.off.map(x=>block(x,a)).join('')||'<p class="small muted">Nada más disponible sin repetir personajes.</p>'}</div>`}).join('')}</div>`;
}

