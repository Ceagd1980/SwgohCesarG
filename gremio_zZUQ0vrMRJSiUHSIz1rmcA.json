/* ======================= GREMIOS / TW ======================= */
S.tw = { gid:null, guilds:{}, zoneSel:null, q:'', view:'mapa',
  opts: Object.assign({strat:'gl', relic:7, perMember:6, slots:25, fleetSlots:25, reserve:'none', maxTypes:3, fill:true}, lsGet('swgoh_tw_opts')||{}) };
const GL_FALLBACK = new Set(['GLREY','SUPREMELEADERKYLOREN','GRANDMASTERLUKE','SITHPALPATINE','JEDIMASTERKENOBI','LORDVADER','JABBATHEHUTT','GLLEIA','GLAHSOKATANO','GLHONDO']);
const isGL = id => (S.chars[id]?.cat||[]).includes('Galactic Legend') || GL_FALLBACK.has(id);
const slugify = s => String(s||'').toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g,'').replace(/['’"().,]/g,'').replace(/&/g,'and').replace(/[^a-z0-9]+/g,'-').replace(/^-|-$/g,'');

/* ---------- lista de gremios ---------- */
function guildList(){
  const map = new Map();
  S.acc.forEach(a=>{ const d=a.p?.data; if(d?.guild_id){ const g=map.get(d.guild_id)||{id:d.guild_id,name:d.guild_name||d.guild_id,mine:[]}; g.mine.push(a.cfg.nombre); map.set(d.guild_id,g);} });
  [...(window.GREMIOS_EXTRA||[]), ...(lsGet('swgoh_gremios_extra')||[])].forEach(x=>{ if(x?.id && !map.has(x.id)) map.set(x.id,{id:x.id,name:x.nombre||x.id,mine:[]}); });
  Object.entries(S.tw.guilds).forEach(([id,g])=>{ const e=map.get(id); if(e && g.info?.name) e.name=g.info.name; });
  return [...map.values()];
}
function addGuild(txt){
  const id = (String(txt).match(/\/g\/([A-Za-z0-9_-]{10,40})/)||[])[1] || (String(txt).trim().match(/^[A-Za-z0-9_-]{10,40}$/)||[])[0];
  if(!id){ alert('Pega el enlace del gremio en swgoh.gg (swgoh.gg/g/…/) o su ID.'); return; }
  const list = lsGet('swgoh_gremios_extra')||[];
  if(!list.some(x=>x.id===id)) list.push({id}); lsSet('swgoh_gremios_extra',list);
  S.tw.gid=id; loadGuild(id,false);
}

/* ---------- datos compactos de cada miembro ---------- */
function compactPlayer(p){
  const d=p.data||{}, u=[];
  (p.units||[]).forEach(x=>{ const v=x.data||x; const g=v.gear_level||0, ct=v.combat_type||1;
    if(ct===1 && g<12 && !v.is_galactic_legend) return;
    if(ct===2 && (v.rarity||0)<5) return;
    u.push([v.base_id, g>=13?Math.max(0,(v.relic_tier||2)-2):-1, g, v.rarity||0, v.power||0, v.is_galactic_legend?1:0, ct]);
  });
  return { n:d.name||'', c:String(d.ally_code||''), gp:d.galactic_power||0, u };
}
function memberUnits(m){
  if(m._u) return m._u;
  const map=new Map(); (m.u||[]).forEach(([id,relic,gear,stars,power,gl,ct])=>map.set(id,{id,relic,gear,stars,power,gl:!!gl,ct,zetas:0,omis:0}));
  Object.defineProperty(m,'_u',{value:map,enumerable:false}); return map;
}
function parseAny(txt){
  try{ return JSON.parse(txt); }catch(e){}
  const pre = txt.match(/<pre[^>]*>([\s\S]*?)<\/pre>/i);
  const raw = (pre?pre[1]:txt).replace(/<[^>]+>/g,'').replace(/&quot;/g,'"').replace(/&#39;/g,"'").replace(/&lt;/g,'<').replace(/&gt;/g,'>').replace(/&amp;/g,'&');
  const a=raw.indexOf('{'), b=raw.lastIndexOf('}'); if(a<0||b<a) throw new Error('no encontré datos');
  return JSON.parse(raw.slice(a,b+1));
}
function slimGuildInfo(j){
  const d=j.data||j;
  return { guild_id:d.guild_id, name:d.name, galactic_power:d.galactic_power, member_count:d.member_count,
    members:(d.members||[]).filter(m=>m.ally_code).map(m=>({ally_code:String(m.ally_code), player_name:m.player_name, galactic_power:m.galactic_power, league_name:m.league_name, member_level:m.member_level, last_activity_time:m.last_activity_time})) };
}

/* ---------- carga del gremio ---------- */
async function loadGuild(gid, force){
  const G = S.tw.guilds[gid] = S.tw.guilds[gid] || {st:'', members:{}, err:''};
  const cache = lsGet('swgoh_g_'+gid);
  if(cache && !force && !G.info){ G.info=cache.info; G.members=cache.members||{}; G.t=cache.t; G.st='ok'; }
  if(cache && !force && Date.now()-cache.t < 12*3600e3 && Object.keys(G.members).length>=(G.info?.members?.length||1)) { if(S.sec==='tw') render(); return; }
  if(G.st==='load') return;
  G.st='load'; G.err=''; G.done=0; if(S.sec==='tw') render();
  // 1) datos del gremio
  try{
    let info=null;
    try{ info = slimGuildInfo(await api('guild-profile/'+gid)); }catch(e){
      const r = await fetch(`gremio_${gid}.json`,{cache:'no-cache'}).catch(()=>null);
      if(r && r.ok) info = slimGuildInfo(parseAny(await r.text())); else throw e;
    }
    if(!info.members.length) throw new Error('el gremio llegó sin miembros');
    G.info = info;
  }catch(e){ G.err=String(e.message||e); if(!G.info && cache?.info){ G.info=cache.info; if(!Object.keys(G.members||{}).length) G.members=cache.members||{}; } if(!G.info){ G.st='err'; if(S.sec==='tw') render(); return; } }
  // 2) roster de cada miembro (de 3 en 3 para no saturar swgoh.gg)
  const list = G.info.members, mineByCode = {};
  S.acc.forEach(a=>{ if(a.p) mineByCode[a.cfg.codigo]=a; });
  const fresh = {};
  let i=0, lastR=0; G.done=0; G.fail=[];
  const worker = async ()=>{
    while(i<list.length){
      const m=list[i++];
      try{
        let p = mineByCode[m.ally_code]?.p;
        if(!p){ try{ p = await fetchPlayer(m.ally_code); }catch(e){ await new Promise(r=>setTimeout(r,1500)); p = await fetchPlayer(m.ally_code); } }
        fresh[m.ally_code] = compactPlayer(p);
      }catch(e){ if(G.members[m.ally_code]) fresh[m.ally_code]=G.members[m.ally_code]; else G.fail.push(m.player_name||m.ally_code); }
      G.done++;
      if(S.sec==='tw' && Date.now()-lastR>900){ lastR=Date.now(); render(); }
    }
  };
  await Promise.all([worker(),worker(),worker()]);
  G.members = fresh; G.t=Date.now(); G.st='ok';
  lsSet('swgoh_g_'+gid,{t:G.t,info:G.info,members:G.members});
  if(S.sec==='tw') render();
}
function loadGuildFile(file, gid){ const rd=new FileReader(); rd.onload=()=>useGuildText(rd.result,gid); rd.readAsText(file); }

/* ---------- plantillas de defensa ---------- */
let _twT=null, _twTkey='';
function twTemplates(){
  const key = Object.keys(S.chars).length+'|'+EQUIPOS.length+'|'+TW_META.length;
  if(_twT && _twTkey===key) return _twT;
  const byName={}, bySlug={};
  Object.entries(S.chars).forEach(([id,c])=>{ const k=slugify(c.name); if(!byName[k]) byName[k]=id; if(c.slug) bySlug[c.slug]=id; });
  const res = n => byName[slugify(n)] || bySlug[slugify(n)] || (S.chars[n]?n:null);
  const groups={}, unresolved=new Set();
  const G = lead => groups[lead] = groups[lead] || {lead, variants:[], flex:null, hold:null, tier:null, est:true, nombre:null};
  TW_META.forEach(m=>{
    const ids=m.e.map(n=>{ const id=res(n); if(!id) unresolved.add(n); return id; });
    if(!ids[0]) return;
    const g=G(ids[0]);
    if(ids.every(Boolean)) g.variants.push({ids, hold:m.hold});
    if(g.hold==null || m.hold>g.hold){ g.hold=m.hold; g.tier=m.t; }
    g.est=false;
  });
  const atk={}; Object.entries(window.TW_ATAQUE||{}).forEach(([n,v])=>{ const id=res(n); if(id) atk[id]=v; else unresolved.add(n); });
  EQUIPOS.forEach(sq=>{ const g=G(sq.lider); g.flex=sq; g.nombre=g.nombre||sq.nombre; });
  const tierEst={1:14,2:11,3:8,4:6,5:5};
  Object.values(groups).forEach(g=>{
    if(g.hold==null) g.hold = tierEst[g.flex?.tier]||6;
    g.nombre = g.nombre || lab(g.lead);
    g.atk = atk[g.lead]||null;
  });
  _twT={groups, unresolved:[...unresolved], atk}; _twTkey=key; return _twT;
}
function squadStats(ids,U){ let r=0,p=0,gl=false; ids.forEach(id=>{const u=U.get(id); r+=Math.max(0,u.relic); p+=u.power; if(u.gl) gl=true;}); return {avgR:r/ids.length, power:p, gl}; }
function memberSquads(U, relicMin){
  const out=[];
  Object.values(twTemplates().groups).forEach(g=>{
    const L=U.get(g.lead); if(!L || L.ct!==1 || (L.stars<7 && !L.gl)) return;
    const cands=[];
    g.variants.forEach(v=>{ if(v.ids.every(id=>U.has(id))) cands.push({ids:v.ids, meta:true}); });
    if(g.flex){
      const core=g.flex.core.filter(id=>U.has(id));
      if(core.length===g.flex.core.length){
        const flex=g.flex.flex.filter(id=>U.has(id) && !core.includes(id)).sort((a,b)=>(U.get(b).relic-U.get(a).relic)||(U.get(b).power-U.get(a).power));
        const ids=[...core,...flex].slice(0,5);
        if(ids.length>=5 || (g.flex.flex.length===0 && ids.length===g.flex.core.length)) cands.push({ids, meta:false});
      }
    }
    let best=null;
    cands.forEach(c=>{
      const st=squadStats(c.ids,U), ok=c.ids.every(id=>U.get(id).relic>=relicMin);
      const rank=(ok?1000:0)+(c.meta?50:0)+st.avgR;
      if(!best || rank>best.rank) best={...c,...st,ok,rank};
    });
    if(!best) return;
    const score = g.hold*(0.55+0.45*Math.min(best.avgR,9)/9);
    out.push({lead:g.lead, nombre:g.nombre, hold:g.hold, est:g.est, tier:g.tier, atk:g.atk, ids:best.ids, avgR:best.avgR, power:best.power, gl:best.gl, ok:best.ok, meta:best.meta, score});
  });
  return out.sort((a,b)=>b.score-a.score);
}

/* ---------- plan de TW ---------- */
function twReserved(sq,O){ return (O.reserve==='gl' && sq.gl) || (O.reserve==='atk' && sq.atk && sq.atk[0]==='S'); }
function twPlan(G){
  const O=S.tw.opts, members=Object.values(G.members||{});
  const pool=[], perMember={}, stats={};
  members.forEach(m=>{
    const U=memberUnits(m), all=memberSquads(U,O.relic);
    all.forEach(s=>{ const st=stats[s.lead]=stats[s.lead]||{lead:s.lead,nombre:s.nombre,hold:s.hold,est:s.est,tier:s.tier,atk:s.atk,ok:0,casi:0,relSum:0,gl:s.gl,placed:0,zones:{},reserved:false}; if(s.ok){st.ok++;st.relSum+=s.avgR;} else st.casi++; if(s.gl) st.gl=true; });
    const used=new Set(), picked=[];
    all.filter(s=>s.ok).forEach(s=>{
      if(twReserved(s,O)){ stats[s.lead].reserved=true; return; }
      if(picked.length<O.perMember && s.ids.every(id=>!used.has(id))){ s.ids.forEach(id=>used.add(id)); picked.push({...s, member:m.n, code:m.c}); }
    });
    perMember[m.c]=picked; pool.push(...picked);
  });
  // grupos por líder: cada territorio lleva pocos tipos de equipo, apilados
  const groups={}; pool.forEach(s=>{ (groups[s.lead]=groups[s.lead]||{lead:s.lead,gl:s.gl,hold:s.hold,copies:[]}).copies.push(s); if(s.gl) groups[s.lead].gl=true; });
  Object.values(groups).forEach(g=>g.copies.sort((a,b)=>b.score-a.score));
  const zones=TW_MAPA.filter(z=>z.tipo==='pj').map(z=>({...z, list:[], extra:false}));
  const maxT=O.maxTypes>0?O.maxTypes:99;
  const room=z=>O.slots-z.list.length, types=z=>new Set(z.list.map(s=>s.lead)).size;
  const move=(z,g,n)=>{ g.copies.splice(0,n).forEach(s=>{s.zone=z.id; z.list.push(s);}); };
  const pickGroup=(z,ranked)=>{
    const avail=ranked.filter(g=>g.copies.length && !z.list.some(s=>s.lead===g.lead)); if(!avail.length) return null;
    // se respeta el orden de prioridad; solo entre equipos de dureza parecida se prefiere el que más copias tiene
    const best=avail[0], win=avail.filter(g=>g.gl===best.gl && g.hold>=best.hold-6);
    const need=Math.ceil(room(z)/Math.max(1,maxT-types(z)));
    return win.find(g=>g.copies.length>=need) || win.find(g=>g.copies.length>=need/2) || best;
  };
  const fillZone=(z,ranked)=>{ while(room(z)>0 && types(z)<maxT){ const g=pickGroup(z,ranked); if(!g) break; move(z,g,Math.min(room(z),g.copies.length)); } };
  const G_=()=>Object.values(groups);
  const byHold=(a,b)=>(b.hold-a.hold)||(b.copies.length-a.copies.length);
  const glFirst=(a,b)=>(b.gl-a.gl)||byHold(a,b);
  const zc=c=>zones.filter(z=>z.col===c), cols=[...new Set(zones.map(z=>z.col))].sort((a,b)=>a-b);
  if(O.strat==='gl'){
    zones.slice().sort((a,b)=>a.col-b.col||a.fila-b.fila).forEach(z=>fillZone(z,G_().sort(glFirst)));
  } else if(O.strat==='trampa'){
    const first=cols[0], last=cols[cols.length-1];
    zc(first).forEach(z=>fillZone(z,G_().filter(g=>!g.gl).sort(byHold)));
    zc(last).forEach(z=>fillZone(z,G_().sort(glFirst)));
    cols.slice(1,-1).forEach(c=>zc(c).forEach(z=>fillZone(z,G_().sort(byHold))));
    zc(first).forEach(z=>fillZone(z,G_().sort(byHold)));
  } else {
    for(let r=0;r<maxT;r++) zones.slice().sort((a,b)=>a.col-b.col||a.fila-b.fila).forEach(z=>{ if(room(z)>0 && types(z)<maxT){ const g=pickGroup(z,G_().sort(byHold)); if(g) move(z,g,Math.min(room(z),Math.ceil(O.slots/maxT),g.copies.length)); } });
    zones.forEach(z=>fillZone(z,G_().sort(byHold)));
  }
  if(O.fill) G_().filter(g=>g.copies.length).sort(byHold).forEach(g=>{
    while(g.copies.length){
      const open=zones.filter(z=>room(z)>0); if(!open.length) return;
      const z=open.find(z=>z.list.some(s=>s.lead===g.lead)) || open.sort((a,b)=>(a.list.length/O.slots-b.list.length/O.slots)||a.col-b.col)[0];
      if(!z.list.some(s=>s.lead===g.lead)) z.extra=true;
      move(z,g,Math.min(room(z),g.copies.length));
    }
  });
  const rest=G_().flatMap(g=>g.copies);
  zones.forEach(z=>z.list.forEach(s=>{ const st=stats[s.lead]; st.placed++; st.zones[z.id]=(st.zones[z.id]||0)+1; }));
  // flota
  const fz=TW_MAPA.filter(z=>z.tipo==='nave').map(z=>({...z,list:[]})).sort((a,b)=>a.col-b.col);
  const fleets=members.map(m=>{
    const U=memberUnits(m), ships=[...U.values()].filter(u=>u.ct===2);
    const caps=ships.filter(u=>/^CAPITAL/.test(u.id) || (S.ships[u.id]?.cat||[]).some(c=>/capital/i.test(c)) || /capital/i.test(S.ships[u.id]?.role||'')).sort((a,b)=>b.power-a.power);
    if(!caps.length) return null;
    const rest7=ships.filter(u=>u.id!==caps[0].id).sort((a,b)=>b.power-a.power).slice(0,7);
    if(rest7.length<3) return null;
    return {member:m.n, code:m.c, cap:caps[0].id, ids:[caps[0].id,...rest7.map(u=>u.id)], power:caps[0].power+rest7.reduce((s,u)=>s+u.power,0)};
  }).filter(Boolean).sort((a,b)=>b.power-a.power);
  fleets.forEach(f=>{ const z=fz.find(z=>z.list.length<O.fleetSlots); if(z){ z.list.push(f); f.zone=z.id; } });
  return {zones, fleetZones:fz, fleets, pool, rest, perMember, stats:Object.values(stats), members};
}
function ctrNeedGL(lead){
  const rows=countersFor(lead).slice(0,10); if(!rows.length) return null;
  return Math.round(100*rows.filter(r=>isGL(r.ids[0])).length/rows.length);
}

