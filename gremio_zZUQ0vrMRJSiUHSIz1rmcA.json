    ${rec.length?`<div class="row">${rec.map(r=>`<span class="rchip"><button class="rv-load" data-c="${r.codigo}">${esc(r.nombre)} <small>${r.codigo}</small></button><button class="rv-del" data-c="${r.codigo}" title="Quitar">×</button></span>`).join('')}</div>`:'<p class="small muted">Los rivales que revises se guardan aquí para volver a abrirlos rápido.</p>'}</div>`;
  if(R.st==='load') return out+'<div class="panel">Leyendo el roster del rival en swgoh.gg…</div>';
  if(R.st==='err') return out+`<div class="err-box">No pude leer ese código: ${esc(R.err)}</div>`;
  if(R.st!=='ok') return out;
  const d=R.p.data||{}, ra={units:R.units};
