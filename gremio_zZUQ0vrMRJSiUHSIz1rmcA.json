function useGuildText(txt, gid){
  try{
    const info=slimGuildInfo(parseAny(txt));
    if(!info.members.length) throw new Error('no vienen miembros');
    const G=S.tw.guilds[gid]=S.tw.guilds[gid]||{members:{}};
    G.info=info; G.st=''; G.err='';
