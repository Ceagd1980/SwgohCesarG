  <p class="small muted"><span class="chip listo">Listo</span> todos a la reliquia mínima · <span class="chip casi">Casi</span> los tienes pero alguno está bajo (borde punteado) · <span class="chip falta">No disponible</span> te falta el núcleo.</p></div>
  <div class="squads">${cards||'<p class="muted">Ningún equipo listo.</p>'}</div>`;
}

function leaderSelect(id, selected){
  const withData = [...new Set([...Object.keys(COUNTERS_BASE),...Object.keys(ctrImported()),...Object.keys(S.ctrRepo)])].sort((x,y)=>lab(x).localeCompare(lab(y)));
  const others = [...new Set(EQUIPOS.map(q=>q.lider))].filter(x=>!withData.includes(x)).sort((x,y)=>lab(x).localeCompare(lab(y)));
  const opt = x => `<option value="${x}" ${selected===x?'selected':''}>${esc(lab(x))}${lab(x)!==uname(x)?' · '+esc(uname(x)):''}</option>`;
  return `<select id="${id}"><optgroup label="Con datos de counters">${withData.map(opt).join('')}</optgroup><optgroup label="Otros líderes (ver en swgoh.gg)">${others.map(opt).join('')}</optgroup></select>`;
}
