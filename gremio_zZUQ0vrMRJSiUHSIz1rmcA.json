}
function zoneHold(z){ return z.list.length ? Math.round(z.list.reduce((s,x)=>s+x.hold,0)/z.list.length) : 0; }
function twMapa(P){
  const O=S.tw.opts, colTxt={1:'Frente',2:'2ª línea',3:'3ª línea',4:'Fondo'};
  const pos=z=>`grid-column:${5-z.col};grid-row:${z.filas===2?(z.fila===1?'1 / span 3':'4 / span 3'):`${(z.fila-1)*2+1} / span 2`}`;
  const card=z=>{
    const fleet=z.tipo==='nave', cap=fleet?O.fleetSlots:O.slots;
    const grp={}; z.list.forEach(s=>{const k=fleet?s.cap:s.lead; grp[k]=(grp[k]||0)+1;});
    const top=Object.entries(grp).sort((a,b)=>b[1]-a[1]).slice(0,fleet?6:5);
    return `<div class="twz ${S.tw.zoneSel===z.id?'sel':''} ${fleet?'fleet':''}" data-z="${z.id}" style="${pos(z)}">
      <div class="twz-h"><b>${z.id}</b><span class="small muted">${fleet?'🚀 Naves':colTxt[z.col]||''}</span><span class="chip ${z.list.length>=cap?'listo':'casi'}">${z.list.length}/${cap}</span></div>
      ${fleet?'':`<div class="small muted">Dureza ${zoneHold(z)}% · ${Object.keys(grp).length} tipos${z.list.some(s=>s.gl)?' · '+z.list.filter(s=>s.gl).length+' GL':''}${z.extra?' · <span style="color:var(--warn)">relleno</span>':''}</div>`}
      <div class="ports" style="margin-top:6px">${top.map(([id,n])=>`<div class="twc">${portrait(id,null,{sm:true,free:true,gl:!fleet&&isGL(id)})}<span>${esc(lab(id))} ×${n}</span></div>`).join('')||'<span class="small muted">vacío</span>'}</div></div>`;
  };
  const all=[...P.zones,...P.fleetZones];
  const sel=all.find(z=>z.id===S.tw.zoneSel);
  const totalSlots=P.zones.length*O.slots, placed=P.zones.reduce((s,z)=>s+z.list.length,0);
  let out=`<div class="panel"><h2>Mapa de defensa</h2>
    <p class="small muted">El rival entra por la <b>derecha</b> (A1/A2) y avanza hacia la izquierda: no puede atacar una columna hasta conquistar la de delante. Toca un territorio para ver quién pone qué. Equipos colocados: <b>${placed}/${totalSlots}</b>${P.rest.length?` · sobran ${P.rest.length} (quedan para atacar)`:''}${placed<totalSlots?` · <span style="color:var(--warn)">faltan ${totalSlots-placed}: sube "Equipos por miembro", baja la reliquia mínima o activa "rellenar"</span>`:''}.</p>
    <div class="twlab"><span>← Fondo (D)</span><span>Frente (A) →</span></div>
    <div class="twmap">${all.map(card).join('')}</div></div>`;
  if(sel){
    const fleet=sel.tipo==='nave';
    out+=`<div class="panel"><h2>${sel.id} · ${sel.list.length} ${fleet?'flotas':'equipos'}</h2><div class="tbl-wrap"><table><thead><tr><th>Miembro</th><th>${fleet?'Flota':'Equipo'}</th><th class="n">${fleet?'Poder':'Reliq. media'}</th>${fleet?'':'<th class="n">Hold</th>'}</tr></thead><tbody>
    ${sel.list.slice().sort((a,b)=>fleet?b.power-a.power:(a.lead.localeCompare(b.lead)||b.avgR-a.avgR)).map(s=>{const U=memberUnits(P.members.find(m=>m.c===s.code)||{});return `<tr><td>${esc(s.member)}</td><td><div class="ports">${s.ids.map(id=>portrait(id,U.get(id),{sm:true,min:fleet?null:S.tw.opts.relic})).join('')}</div></td><td class="n">${fleet?fmtM(s.power):'R'+s.avgR.toFixed(1)}</td>${fleet?'':`<td class="n">${s.hold}%${s.est?'*':''}</td>`}</tr>`}).join('')}
    </tbody></table></div></div>`;
  }
  return out;
}
function twEquipos(P){
  const rows=P.stats.filter(s=>s.ok+s.casi>0).sort((a,b)=>(b.hold-a.hold)||(b.ok-a.ok));
  return `<div class="panel"><h2>Equipos que puede armar el gremio</h2>
  <p class="small muted"><b>Tier def. / Hold</b> = tier list de defensa y % de defensas que aguantan; <b>Tier ataque</b> = tier list de ataque y % de victorias atacando (${esc(TW_FUENTE)}). * = estimado. <b>Listos</b> = miembros que la tienen completa a R${S.tw.opts.relic}+. <b>Counters con GL</b> = de sus mejores counters, cuántos necesitan una Leyenda: cuanto más alto, más caro le sale al rival.</p>
  <div class="tbl-wrap"><table><thead><tr><th>Equipo</th><th class="n">Tier def.</th><th class="n">Hold</th><th class="n">Tier ataque</th><th>Mejor para</th><th class="n">Listos</th><th class="n">Bajos</th><th class="n">Reliq. media</th><th class="n">Counters con GL</th><th class="n">Colocados</th><th>Dónde</th></tr></thead><tbody>
  ${rows.map(s=>{const need=ctrNeedGL(s.lead);return `<tr><td><div class="row">${portrait(s.lead,null,{sm:true,free:true,gl:s.gl})}<span><b>${esc(s.nombre)}</b>${s.gl?' <span class="chip casi">GL</span>':''}</span></div></td>
  <td class="n">${s.tier||'–'}</td><td class="n"><b class="pct" style="color:${s.hold>=20?'var(--ok)':s.hold>=12?'#fff':'var(--tx3)'}">${s.hold}%</b>${s.est?'*':''}</td>
  <td class="n">${s.atk?`${s.atk[0]} · ${s.atk[1]}%`:'–'}</td><td>${twRole(s)}</td><td class="n">${s.ok}</td><td class="n muted">${s.casi}</td><td class="n">${s.ok?'R'+(s.relSum/s.ok).toFixed(1):'–'}</td>
  <td class="n">${need==null?'<span class="muted">–</span>':need+'%'}</td><td class="n">${s.placed}</td><td class="small">${Object.entries(s.zones).sort((a,b)=>a[0].localeCompare(b[0])).map(([z,n])=>`${z}×${n}`).join(' ')}</td></tr>`}).join('')}
  </tbody></table></div></div>`;
}
function twRole(s){
  const atkS = s.atk && (s.atk[0]==='S' || (s.atk[0]==='A' && s.atk[1]>=85));
  if(s.reserved) return '<span class="chip casi">⚔ guardado</span>';
  if(s.hold>=20 && !atkS) return '<span class="chip listo">🛡 Defensa</span>';
  if(atkS && s.hold<25) return '<span class="chip casi">⚔ Ataque</span>';
  if(s.hold>=20) return '<span class="chip listo">🛡 / ⚔ ambos</span>';
  if(s.hold<11) return '<span class="chip falta">⚔ Ataque</span>';
  return '<span class="muted small">relleno</span>';
}
function twMiembros(P){
  const q=S.tw.q.toLowerCase(), mine=new Set(CUENTAS.map(c=>c.codigo));
  const ms=P.members.slice().sort((a,b)=>(mine.has(b.c)-mine.has(a.c))||b.gp-a.gp).filter(m=>!q||m.n.toLowerCase().includes(q));
  const fleetBy={}; P.fleets.forEach(f=>{ if(f.zone) fleetBy[f.code]=f; });
  return `<div class="panel"><h2>Qué pone cada miembro</h2><div class="ctrl"><input type="text" id="twQ" placeholder="Buscar miembro…" value="${esc(S.tw.q)}"></div>
  ${ms.map(m=>{const U=memberUnits(m), sq=P.perMember[m.c]||[], f=fleetBy[m.c];
    return `<div class="accrow" style="align-items:flex-start;flex-wrap:wrap"><span class="an" style="width:150px">${mine.has(m.c)?'⭐ ':''}${esc(m.n)}<br><span class="small muted">${fmtM(m.gp)} · ${sq.length} def.</span></span>
    <div style="flex:1;display:flex;flex-wrap:wrap;gap:10px">${sq.map(s=>`<div class="twsq"><span class="chip ${s.zone?'listo':''}">${s.zone||'reserva'}</span><div class="ports">${s.ids.map(id=>portrait(id,U.get(id),{sm:true,min:S.tw.opts.relic})).join('')}</div></div>`).join('')||'<span class="small muted">Sin equipos a la reliquia mínima.</span>'}
    ${f?`<div class="twsq"><span class="chip listo">${f.zone}</span><div class="ports">${f.ids.slice(0,4).map(id=>portrait(id,U.get(id),{sm:true})).join('')}</div></div>`:''}</div></div>`}).join('')}</div>`;
}
function twIdeas(P){
  const O=S.tw.opts;
  const st=P.stats.filter(s=>s.ok>0);
  const trap=st.filter(s=>!s.gl && s.ok>=3).sort((a,b)=>b.hold-a.hold||b.ok-a.ok).slice(0,6);
  const gls=st.filter(s=>s.gl).sort((a,b)=>b.hold-a.hold);
  const weak=st.filter(s=>!s.gl && s.hold<10 && s.ok>=5).sort((a,b)=>a.hold-b.hold).slice(0,5);
  const front=P.zones.filter(z=>z.col===1);
  const li=s=>`<li><b>${esc(s.nombre)}</b> · hold ${s.hold}%${s.est?'*':''} · ${s.ok} miembros listos${ctrNeedGL(s.lead)!=null?` · ${ctrNeedGL(s.lead)}% de sus counters usan GL`:''}</li>`;
  return `<div class="cols">
   <div class="panel"><h3>🛡 Candidatas para el frente (sin GL)</h3><p class="small muted">Las defensas más duras que el gremio tiene repetidas. Puestas en bloque en T1/B1 obligan al rival a tener muchos counters del mismo tipo.</p><ul class="small">${trap.map(li).join('')||'<li class="muted">Ninguna con 3+ copias.</li>'}</ul></div>
   <div class="panel"><h3>👑 Sus Leyendas Galácticas</h3><p class="small muted">Según la tier list de defensa: SLKR aguanta ~42%, Rey GL ~38% y Leia GL ~28%, pero LV 22%, Ahsoka GL 19% y Hondo GL 16%. Varias GL aguantan menos que Stranger (40%), Bastila/JML (28%), Rotta (27%) o Cere (26%), y además son las mejores para atacar: ponerlas todas al frente gasta tu ataque.</p><ul class="small">${gls.map(li).join('')||'<li class="muted">Sin GL listas.</li>'}</ul></div>
   <div class="panel"><h3>⚔ Mejor para atacar que para defender</h3><p class="small muted">Tier alto en ataque y poco hold en defensa: guárdalos para conquistar.</p><ul class="small">${st.filter(s=>s.atk && (s.atk[0]==='S'||s.atk[0]==='A') && s.hold<20).sort((a,b)=>b.atk[1]-a.atk[1]).slice(0,6).map(s=>`<li><b>${esc(s.nombre)}</b> · ataque ${s.atk[0]} (${s.atk[1]}%) · defensa ${s.hold}% · ${s.ok} listos</li>`).join('')||'<li class="muted">—</li>'}</ul>
   <p class="small muted">Y estos casi nunca aguantan en defensa:</p><ul class="small">${weak.map(li).join('')||'<li class="muted">—</li>'}</ul></div>
   <div class="panel"><h3>📌 Cómo queda el frente ahora</h3><ul class="small">${front.map(z=>`<li><b>${z.id}</b>: ${z.list.length}/${O.slots} equipos · dureza media ${zoneHold(z)}% · ${z.list.filter(s=>s.gl).length} GL</li>`).join('')}</ul>
   <p class="small muted">Prueba cambiar la estrategia arriba y compara la dureza media del frente. Los porcentajes son de GAC 5v5: en TW el rival ataca con todo su roster, así que tómalos como guía, no como dato exacto.</p></div></div>`;
}
function twCopyText(P){
  const lines=[`TW · ${S.tw.guilds[S.tw.gid]?.info?.name||''} · estrategia: ${{gl:'GL al frente',trampa:'trampas al frente',equil:'equilibrado'}[S.tw.opts.strat]}`]; P.zones.forEach(z=>{ const g={}; z.list.forEach(s=>g[s.lead]=(g[s.lead]||0)+1); lines.push(`${z.id}: `+Object.entries(g).map(([l,n])=>`${lab(l)} ×${n}`).join(', ')); }); lines.push('');
  P.members.slice().sort((a,b)=>a.n.localeCompare(b.n)).forEach(m=>{
    const sq=(P.perMember[m.c]||[]).filter(s=>s.zone); const f=P.fleets.find(f=>f.code===m.c && f.zone);
    if(!sq.length && !f) return;
    lines.push(`• ${m.n}: `+sq.map(s=>`${s.zone} ${lab(s.lead)}`).join(' | ')+(f?` | ${f.zone} flota ${lab(f.cap)}`:''));
  });
  return lines.join('\n');
}

/* ======================= EVENTOS ======================= */
function bind(){
  const $=id=>document.getElementById(id), on=(id,ev,f)=>{const e=$(id);if(e)e.addEventListener(ev,f)};
  const R=S.roster;
  on('rFac','change',e=>{R.fac=e.target.value;render()});
  on('rSide','change',e=>{R.side=e.target.value;render()});
  on('rMin','change',e=>{R.minR=+e.target.value;render()});
  on('rSort','change',e=>{R.sort=e.target.value;render()});
  on('rGroup','change',e=>{R.group=e.target.checked;render()});
  on('rLocked','change',e=>{R.showLocked=e.target.checked;render()});
  on('rQ','change',e=>{R.q=e.target.value;render()});
  on('sqSize','change',e=>{S.squadSize=+e.target.value;render()});
  on('sqSize2','change',e=>{S.squadSize=+e.target.value;render()});
  on('onlyReady','change',e=>{S.onlyReady=e.target.checked;render()});
  on('cLead','change',e=>{S.counterLead=e.target.value;render()});
  on('cOther','change',e=>{const v=e.target.value.trim().toLowerCase();const hit=Object.entries(S.chars).find(([id,c])=>c.name.toLowerCase()===v||id.toLowerCase()===v)||Object.entries(ABREV).map(([id,ab])=>[id,{name:ab}]).find(([id,c])=>c.name.toLowerCase()===v);if(hit){S.counterLead=hit[0];render()}});
  on('pMode','change',e=>{S.plan.mode=e.target.value;S.plan.ndef=e.target.value==='gac'?5:10;render()});
  on('pDef','change',e=>{S.plan.ndef=Math.max(1,+e.target.value||1);render()});
  on('pCasi','change',e=>{S.plan.casi=e.target.checked;render()});
  on('rvGo','click',()=>loadRival($('rvCode').value));
  on('fCtr','change',e=>importCounterFiles(e.target.files));
  on('dlCtr','click',downloadCountersJSON);
  document.querySelectorAll('.ctr-go').forEach(a=>a.onclick=e=>{e.preventDefault();S.counterLead=a.dataset.l;render()});
  on('goDiag','click',e=>{e.preventDefault();S.sec='diag';renderTabs();render()});
  on('fChars','change',e=>{if(e.target.files[0])loadManualFile(e.target.files[0],'chars')});
  on('fShips','change',e=>{if(e.target.files[0])loadManualFile(e.target.files[0],'ships')});
  document.querySelectorAll('.tw-g').forEach(b=>b.onclick=()=>{S.tw.gid=b.dataset.g;S.tw.zoneSel=null;render()});
  document.querySelectorAll('.tw-v').forEach(b=>b.onclick=()=>{S.tw.view=b.dataset.v;render()});
  document.querySelectorAll('.twz').forEach(b=>b.onclick=()=>{S.tw.zoneSel=S.tw.zoneSel===b.dataset.z?null:b.dataset.z;render()});
  on('twAddGo','click',()=>addGuild($('twAdd').value));
  on('twAdd','keydown',e=>{if(e.key==='Enter')addGuild(e.target.value)});
  on('twReload','click',()=>loadGuild(S.tw.gid,true));
  on('twPasteGo','click',()=>useGuildText($('twPaste').value,S.tw.gid));
  on('twManual','click',()=>{S.tw.manual=!S.tw.manual;render()});
  on('twFile','change',e=>{if(e.target.files[0])loadGuildFile(e.target.files[0],S.tw.gid)});
  const twSet=(k,v)=>{S.tw.opts[k]=v;lsSet('swgoh_tw_opts',S.tw.opts);render()};
  on('twStrat','change',e=>twSet('strat',e.target.value));
  on('twRelic','change',e=>twSet('relic',+e.target.value));
  on('twPer','change',e=>twSet('perMember',Math.max(1,+e.target.value||1)));
  on('twSlots','change',e=>twSet('slots',Math.max(1,+e.target.value||1)));
  on('twFSlots','change',e=>twSet('fleetSlots',Math.max(1,+e.target.value||1)));
  on('twRes','change',e=>twSet('reserve',e.target.value));
  on('twMaxT','change',e=>twSet('maxTypes',+e.target.value));
  on('twFill','change',e=>twSet('fill',e.target.checked));
  on('twQ','change',e=>{S.tw.q=e.target.value;render()});
  on('twCopy','click',()=>{const G=S.tw.guilds[S.tw.gid]; if(!G) return; const t=twCopyText(twPlan(G)); (navigator.clipboard?navigator.clipboard.writeText(t):Promise.reject()).then(()=>alert('Plan copiado: pégalo en Discord.')).catch(()=>prompt('Copia el plan:',t));});
  on('rvCode','keydown',e=>{if(e.key==='Enter')loadRival(e.target.value)});
  document.querySelectorAll('.rv-load').forEach(b=>b.onclick=()=>loadRival(b.dataset.c));
  document.querySelectorAll('.rv-del').forEach(b=>b.onclick=()=>{lsSet('swgoh_rivales',rivals().filter(r=>r.codigo!==b.dataset.c));render()});
}
document.getElementById('btnRefresh').onclick=async()=>{
  await loadDB(true);
  await Promise.all(S.acc.map((_,i)=>loadAcc(i,true).then(()=>{renderTabs();render()})));
  if(S.rival.code && S.rival.st==='ok') await loadRival(S.rival.code);
  renderTabs();render();
};

/* ======================= INICIO ======================= */
(async function init(){
  renderTabs();
  const qp=new URLSearchParams(location.search).get('rival');
  await loadDB(false);
  try{ const r=await fetch('counters.json',{cache:'no-cache'}); if(r.ok){ const j=await r.json(); if(j && typeof j==='object' && !Array.isArray(j)) S.ctrRepo=j; } }catch(e){}
  await Promise.all(S.acc.map((_,i)=>loadAcc(i,false).then(()=>{renderTabs();render()})));
  if(qp){S.sec='rival';renderTabs();loadRival(qp);}
  renderTabs();render();
})();

</script>


